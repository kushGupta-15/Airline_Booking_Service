# Airline Booking Service Environment Configuration

# Server Port (API Gateway expects Booking Service at port 3002)
PORT=3002

# Flights & Search Service Base URL
FLIGHT_SERVICE_PATH=http://localhost:3000

# RabbitMQ Message Broker Configuration
MESSAGE_BROKER_URL=amqp://localhost:5672
EXCHANGE_NAME=AIRLINE_BUS
REMINDER_BINDING_KEY=REMINDER_SERVICE

# Database Synchronization (optional: set to true to sync sequelize models on startup)
DB_SYNC=false

# Node Environment
NODE_ENV=development
